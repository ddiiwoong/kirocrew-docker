# ============================================================================
#  이 파일을 .env 로 복사해서 값을 채운다.
#    cp .env.example .env
#  .env 는 .gitignore 에 있다. 절대 커밋하지 말 것 (TS_AUTHKEY 가 들어간다).
# ============================================================================

# ============================================================================
#  포트 -- 이 파일이 단일 출처. 포트를 바꿀 때 여기만 고친다.
# ============================================================================
# 내 PC 브라우저로 접속할 호스트 포트 -> http://127.0.0.1:<HOST_PORT>
HOST_PORT=15476

# 컨테이너 내부에서 대시보드가 실제로 리스닝할 포트.
# KIROCREW_PORT 는 볼륨에 저장된 config 의 dashboard.url 보다 우선한다.
# HOST_PORT 와 같은 값으로 두면 대시보드가 스스로 만드는 절대 URL
# (OAuth 리다이렉트, 웹훅 Origin 체크)까지 전부 일치한다.
KIROCREW_PORT=15476

# ============================================================================
#  Tailscale
# ============================================================================
# tailnet 상의 노드 이름 -> MagicDNS: <TS_HOSTNAME>.<TS_TAILNET>
TS_HOSTNAME=kirocrew

# 내 tailnet 의 MagicDNS 도메인. 인증을 끝낸 뒤 아래로 확인해 채운다:
#   docker compose exec tailscale tailscale status --json
# 예: tailXXXXXX.ts.net
TS_TAILNET=

# 무인 로그인용 auth key. https://login.tailscale.com/admin/settings/keys
#   - Reusable 켜기 (컨테이너를 다시 만들어도 같은 키 사용)
#   - Ephemeral 끄기 (켜면 컨테이너 중단 시 노드가 tailnet 에서 사라진다)
#   - 태그를 붙였다면 TS_EXTRA_ARGS 에 같은 태그를 넣어야 한다
# 비워두면 대화형 로그인으로 넘어간다:
#   docker compose logs -f tailscale   -> 출력된 URL 을 열어 승인
#   (또는 ./kirocrew.sh tsauth 로 URL 만 뽑아볼 수 있다)
# 인증 상태는 kirocrew-tailscale-state 볼륨에 남으므로 1회만 하면 된다.
# 이 값은 비밀정보다. 커밋하면 즉시 콘솔에서 폐기(revoke)해야 한다.
TS_AUTHKEY=

# 태그된 authkey 를 쓸 때만: --advertise-tags=tag:kirocrew
TS_EXTRA_ARGS=

# true = userspace 모드 (/dev/net/tun, NET_ADMIN 불필요). 인바운드 접속은 정상.
# 컨테이너에서 tailnet 의 다른 노드로 나가야 하면 false 로 바꾸고
# docker-compose.yml 의 devices/cap_add 주석을 해제할 것.
TS_USERSPACE=true

# ============================================================================
#  tailnet 이름으로 접속하려면 -- 인증 후 채운다
# ============================================================================
# 게이트웨이는 자기가 서비스하지 않는 Host 헤더를 403 "Host header not allowed"
# 으로 거절한다 (DNS-rebinding 방어). 기본 허용 목록은
# localhost / 127.0.0.1 / ::1 / kirocrew.localhost 뿐이다.
# 이 값 하나가 CSRF Origin 허용 목록과 Host 허용 목록에 동시에 반영된다.
#
# 표기 세 개를 모두 넣어야 한다. Host 허용 목록은 호스트명 완전일치이므로
# FQDN 하나만 넣으면 짧은 이름(http://kirocrew:PORT)과 노드 IP
# (http://100.x.y.z:PORT)가 403 으로 막힌다 -- 실측으로 확인했다.
# Tailscale 은 상황에 따라 그 둘을 건네주므로 셋 다 필요하다.
#
# 호스트명은 리터럴로 적는다. ${TS_HOSTNAME}.${TS_TAILNET} 로 조립하면 중첩
# 보간이 어긋나 값이 깨지는 것을 실측했다. 포트만 ${KIROCREW_PORT} 를 참조한다.
#
# 노드를 다시 만들면 100.x 주소가 바뀌므로 그때는 이 줄을 고칠 것.
# 여러 개는 쉼표로 구분한다. 아래 예시의 tailXXXXXX / 100.x.y.z 를 교체하고
# 주석을 해제한다.
#
#   (a) 평문 HTTP + 포트 직결 -- 기본 구성
#KIROCREW_CORS_ORIGINS=http://kirocrew.tailXXXXXX.ts.net:${KIROCREW_PORT},http://kirocrew:${KIROCREW_PORT},http://100.x.y.z:${KIROCREW_PORT}
#
#   (b) tailscale serve 로 HTTPS 443 을 앞에 세운 경우 -- 포트가 붙지 않는다
#       (a) 와 택일. 두 줄을 동시에 해제하면 나중 줄이 앞 줄을 조용히 덮어쓴다.
#KIROCREW_CORS_ORIGINS=https://kirocrew.tailXXXXXX.ts.net
KIROCREW_CORS_ORIGINS=

# ============================================================================
#  Google(Gmail) 로그인 벽 -- OAuth2 Proxy (선택)
#  공개 Funnel 로 외부인에게 노출하되 허용한 Gmail 계정만 통과시킬 때만 필요.
#  tailnet 전용(serve)이나 로컬 전용이면 아래는 비워두고 proxy 를 안 띄우면 된다.
#
#  기동:  docker compose --profile auth up -d
#         docker compose exec tailscale tailscale funnel 4180   # 15476 아님!
#  이때 KIROCREW_CORS_ORIGINS 는 위 (b) 형태(https://<FQDN>, 포트 없음)로 둘 것.
# ============================================================================
# 공개 FQDN (포트·스킴 없이 호스트명만). Funnel 이 노출하는 그 이름.
#   예: kirocrew.tailXXXXXX.ts.net
OAUTH2_PUBLIC_FQDN=

# Google Cloud Console > APIs & Services > Credentials >
#   "OAuth 2.0 Client ID" (Application type: Web application) 에서 발급.
#   Authorized redirect URI 에 https://<OAUTH2_PUBLIC_FQDN>/oauth2/callback 를 넣어야 한다.
# 이 둘은 비밀정보다. 커밋 금지.
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=

# 세션 쿠키 암호화 키. 정확히 32바이트여야 한다 (16/24/32 중).
# 함정: `openssl rand -base64 32` 출력은 44글자 → 44바이트로 읽혀 거부된다.
# 32글자 평문으로 생성해서 붙여넣는다:
#   LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32; echo
OAUTH2_COOKIE_SECRET=
